{
  "name": "bug-hotline",
  "version": "1.0.1",
  "description": "Bug communication service",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "build": "node tools/build.cjs && node tools/build-city.cjs",
    "build:desktop": "npm run build && node tools/prepare-desktop.cjs",
    "desktop:build": "npm run build:desktop && cargo tauri build",
    "test": "node --test test/*.cjs",
    "test:browser": "node --test test/browser/*.browser.test.cjs",
    "test:all": "npm test && npm run test:browser"
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
